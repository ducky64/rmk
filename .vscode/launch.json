{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Probe-rs - ch32v203",
            "type": "probe-rs-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/examples/use_rust/ch32v203",
            "chip": "ch32v203k8t6",
            // "speed": 24000,
            "runtimeExecutable": "probe-rs",
            "runtimeArgs": [
                "dap-server"
            ],
            "flashingConfig": {
                "flashingEnabled": true,
                "resetAfterFlashing": true,
                "haltAfterReset": false,
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/examples/use_rust/ch32v203/target/riscv32imc-unknown-none-elf/release/rmk-ch32v203",
                    "chip": "ch32v203k8t6",
                    // "svdFile": "${workspaceFolder}/examples/use_rust/stm32f4/STM32F411.svd",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            // Format RTT data as String data
                            "dataFormat": "Defmt",
                            // Include host-side timestamps for every line of data transferred from the target RTT output
                            "showTimestamps": true
                        },
                    ],
                }
            ],
        },

    ]
}
